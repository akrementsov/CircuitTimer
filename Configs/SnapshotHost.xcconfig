#include "App.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID).snapshothost
PRODUCT_NAME = $(TARGET_NAME)
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = CircuitTimer Snapshots
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIUserInterfaceStyle = Dark
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
CODE_SIGN_STYLE = Automatic
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_APPROACHABLE_CONCURRENCY = NO
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_EMIT_LOC_STRINGS = YES
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SNAPSHOT_CONTENT_SIZE_CATEGORY = UICTContentSizeCategoryL
