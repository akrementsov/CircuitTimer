// The UI test target: the app's identifiers from App.xcconfig, and Swift settings as strict as the app's.
#include "App.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID).uitests
PRODUCT_NAME = $(TARGET_NAME)
TEST_TARGET_NAME = CircuitTimer
GENERATE_INFOPLIST_FILE = YES
CODE_SIGN_STYLE = Automatic
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @loader_path/Frameworks
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = NO
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
TARGETED_DEVICE_FAMILY = 1
