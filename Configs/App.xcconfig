// The single place for the app's identifiers; Configs/ExportOptions.plist repeats DEVELOPMENT_TEAM for export.
// CT-4 and CT-5 derive APP_GROUP_ID = group.$(APP_BUNDLE_ID) and ICLOUD_CONTAINER_ID = iCloud.$(APP_BUNDLE_ID) from it.

APP_BUNDLE_ID = com.akrementsov.circuittimer

PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID)
DEVELOPMENT_TEAM = R38U4DJ547
