// The single place for the app's identifiers and version, shared by the app and its widget extension, which must
// match; Configs/ExportOptions.plist repeats DEVELOPMENT_TEAM for export.
// An app group, when a later change needs one, is APP_GROUP_ID = group.$(APP_BUNDLE_ID); CT-5 derives
// ICLOUD_CONTAINER_ID = iCloud.$(APP_BUNDLE_ID).

APP_BUNDLE_ID = com.akrementsov.circuittimer
WIDGETS_BUNDLE_ID = $(APP_BUNDLE_ID).widgets

PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID)
DEVELOPMENT_TEAM = R38U4DJ547
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
