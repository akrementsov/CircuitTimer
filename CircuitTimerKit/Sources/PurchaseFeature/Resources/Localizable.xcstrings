{
  "sourceLanguage" : "en",
  "strings" : {
    "purchase.alert.confirmationFailed.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The App Store reported success, but the full version hasn't unlocked yet. Tap Restore Purchases to check again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store сообщил об успехе, но полная версия пока не открылась. Нажмите «Восстановить покупки», чтобы проверить ещё раз."
          }
        }
      }
    },
    "purchase.alert.confirmationFailed.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't Confirm the Purchase"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подтвердить покупку"
          }
        }
      }
    },
    "purchase.alert.nothingToRestore.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Apple ID hasn't bought the full version. If you bought it with another one, sign in to it in the App Store settings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С этим Apple ID полная версия не покупалась. Если покупали с другого, войдите в него в настройках App Store."
          }
        }
      }
    },
