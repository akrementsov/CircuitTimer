    "timer.notifications.alertsOff" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notification alerts are off in iOS Settings. Background stage changes may not appear."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показ уведомлений выключен в настройках iOS. Смена этапов в фоне может не отобразиться."
          }
        }
      }
    },
    "timer.notifications.coverage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background alerts cover the next 32 stage changes or finish, up to a manual pause. Sound follows Sound in Settings. iOS controls delivery and sound; open CircuitTimer to extend coverage."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В фоне уведомления охватывают ближайшие 32 смены этапа или завершение, до ручной паузы. Звук следует настройке «Звук». Показом и звуком управляет iOS; открывайте CircuitTimer для следующих уведомлений."
          }
        }
      }
    },
    "timer.notifications.denied" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are denied. Enable them in Settings → CircuitTimer → Notifications."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления запрещены. Включите их: Настройки → CircuitTimer → Уведомления."
          }
        }
      }
    },
    "timer.notifications.failed" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some background notifications could not be confirmed. CircuitTimer will retry while open."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не все фоновые уведомления удалось подтвердить. CircuitTimer повторит попытку, пока приложение открыто."
          }
        }
      }
    },
    "timer.notifications.finished" : {
