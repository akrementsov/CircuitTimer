    "Resume workout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume workout"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить тренировку"
          }
        }
