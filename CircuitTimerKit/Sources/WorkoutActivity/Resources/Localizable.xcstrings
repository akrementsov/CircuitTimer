    "The previous workout action is still finishing. Try again shortly.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous workout action is still finishing. Try again shortly."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущее действие ещё выполняется. Повторите чуть позже."
          }
        }
      }
    },
    "The workout action is taking longer than expected. Check the timer in the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workout action is taking longer than expected. Check the timer in the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действие занимает больше времени, чем ожидалось. Проверьте таймер в приложении."
          }
        }
      }
    },
    "The workout could not be updated. Open the timer in the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workout could not be updated. Open the timer in the app."
