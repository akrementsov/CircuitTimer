    "settings.notifications.alertsOff" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notification alerts are off. Enable them in iOS Settings to see stage changes in the background."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показ уведомлений выключен. Включите его в настройках iOS, чтобы видеть смену этапов в фоне."
          }
        }
      }
    },
    "settings.notifications.coverage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifies you of stage changes on the Lock Screen. Open the app from time to time to refresh notifications."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщает о смене этапов на экране блокировки. Открывайте приложение время от времени, чтобы обновить уведомления."
          }
        }
      }
    },
    "settings.notifications.denied" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are denied. Enable them in iOS Settings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления запрещены. Включите их в настройках iOS."
